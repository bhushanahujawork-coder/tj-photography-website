# TJ Photography Backend — PRODUCTION Environment Configuration
# Copy this to .env and fill in all values before deploying.

ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Generate a secure random key: openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-64-character-hex-string-in-production

DATABASE_URL=postgresql+asyncpg://tjphotography:YOUR_DB_PASSWORD@postgres:5432/tj_photography

STORAGE_BACKEND=s3
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_BUCKET=tj-photography

CORS_ORIGINS=["https://tjphotography.com", "https://www.tjphotography.com"]

REDIS_URL=redis://redis:6379/0

RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
