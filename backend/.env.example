# TJ Photography Backend — Environment Configuration

# Application
APP_NAME=TJ Photography API
VERSION=0.2.0
DEBUG=false
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database — PostgreSQL (async with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tj_photography

# Security
SECRET_KEY=d09f8e7c6a5b4f3e2d1c0b9a8f7e6d5c4b3a2f1e0d9c8b7a6f5e4d3c2b1a0
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=5

# Storage — local filesystem (development) or Cloudflare R2 (production)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage

# Cloudflare R2 (only when STORAGE_BACKEND=s3)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_BUCKET=tj-photography

# Upload Limits
UPLOAD_MAX_SIZE=52428800
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp,.heic,.tiff

# CORS — comma-separated origins
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

# Redis
REDIS_URL=redis://localhost:6379/0

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
